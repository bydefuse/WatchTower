# Bu dosyayı .env olarak kopyalayın; tüm değerler isteğe bağlıdır.
PORT=3000
# 127.0.0.1: yalnızca bu bilgisayar. Ağdan erişim için 0.0.0.0 yazın (bkz. README, Güvenlik)
HOST=127.0.0.1
INTERVAL_MS=1500
CPU_ALERT=90
RAM_ALERT=90
ALERT_COOLDOWN_SEC=300
# Uyarılar bu Discord webhook'una embed olarak gönderilir
DISCORD_WEBHOOK_URL=
